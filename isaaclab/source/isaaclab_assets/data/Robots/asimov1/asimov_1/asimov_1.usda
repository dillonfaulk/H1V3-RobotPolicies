#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "asimov_1"
    doc = """Generated from Composed Stage of root layer /tmp/tmpzahvz1j8/asimov_1.usdc


